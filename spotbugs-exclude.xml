<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- EI_EXPOSE_REP/REP2: constructor-injected Spring beans are shared,
         framework-managed singletons, not caller-owned mutable state — this
         is how dependency injection works, not a representation leak. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Or>
            <Field name="jdbcTemplate"/>
            <Field name="txManager"/>
            <Field name="currentFinancierHolder"/>
            <Field name="otpStore"/>
            <Field name="objectMapper"/>
            <Field name="redis"/>
        </Or>
    </Match>

    <!-- BYTEA columns are necessarily byte[] on the JPA entity; Hibernate
         owns the array's lifecycle between load and flush, so the usual
         "copy defensively" fix doesn't apply the way it would to a plain
         POJO. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Or>
            <Field name="panEncrypted"/>
            <Field name="accountNumberEncrypted"/>
        </Or>
    </Match>
</FindBugsFilter>
